        "adPrivacyA11y": "ಜಾಹೀರಾತು ಗೌಪ್ಯತೆ ಆಯ್ಕೆಗಳನ್ನು ನೋಡಿ",
        "adsPrivacyIntro": "HydroFit ಜಾಹೀರಾತುಗಳನ್ನು ಹೇಗೆ ತೋರಿಸುತ್ತದೆ ಮತ್ತು ಒಪ್ಪಿಗೆಯನ್ನು ಹೇಗೆ ನಿಯಂತ್ರಿಸುವುದು.",
        "adsPrivacyWhatHeading": "ನೀವು ನೋಡುವುದು",
        "adsPrivacyWhatBody": "ಟ್ಯಾಬ್ ಬಾರ್ ಮೇಲೆ ಬ್ಯಾನರ್ ಇರುತ್ತದೆ. ಸಲಹೆಗಳಲ್ಲಿ ಮುಚ್ಚಬಹುದಾದ ಬ್ಯಾನರ್ ಕಾಣಿಸುತ್ತದೆ. ಸಾಧನೆ ಅನ್‌ಲಾಕ್ ಮಾಡಿದಾಗಲೂ ಮುಚ್ಚಬಹುದಾದ ಬ್ಯಾನರ್ ಬರುತ್ತದೆ, ಪೂರ್ಣ-ಪರದೆ ಜಾಹೀರಾತು ಅಲ್ಲ. ದಿನದ ಪ್ರತಿ ಮೂರನೇ ಲಾಗ್ ನಂತರ ಅಥವಾ ಮೊದಲ ಬಾರಿ ದೈನಂದಿನ ಗುರಿ ತಲುಪಿದಾಗ ಪೂರ್ಣ-ಪರದೆ ಜಾಹೀರಾತು ಬರಬಹುದು.",
        "adsPrivacyWhenHeading": "ಜಾಹೀರಾತುಗಳು ಯಾವಾಗ ಬರುತ್ತವೆ",
        "adsPrivacyWhenBody": "ಆನ್‌ಬೋರ್ಡಿಂಗ್ ಅಥವಾ ಲಾಂಚ್‌ನಲ್ಲಿ ಜಾಹೀರಾತುಗಳು ಬರುವುದಿಲ್ಲ. ಲಾಗ್ ಮಾಡಲ್‌ನಿಂದ ಸಮಯದೊಂದಿಗೆ ನಮೂದಿಸಿದ ಎಂಟ್ರಿಗಳಿಗೆ ಪೂರ್ಣ-ಪರದೆ ಜಾಹೀರಾತುಗಳನ್ನು ಬಿಟ್ಟುಬಿಡುತ್ತೇವೆ; ಪ್ರತಿ ಟ್ಯಾಪ್‌ಗೆ ಬರುವುದಿಲ್ಲ. ಜಾಹೀರಾತು ಲೋಡ್ ಆಗದಿದ್ದರೂ ಲಾಗ್ ಯಶಸ್ವಿಯಾಗುತ್ತದೆ.",
        "adsPrivacyDataHeading": "ಜಾಹೀರಾತು ಡೇಟಾ",
        "adsPrivacyDataBody": "HydroFit Google AdMob ಬಳಸುತ್ತದೆ. ಜಾಹೀರಾತಿಗಾಗಿ Google ಸಾಧನ ಗುರುತುಗಳನ್ನು ಸಂಗ್ರಹಿಸಬಹುದು. HydroFit ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಮಾರಾಟ ಮಾಡುವುದಿಲ್ಲ; ನಿಮ್ಮ ಹೈಡ್ರೇಷನ್ ಲಾಗ್‌ಗಳು ಈ ಸಾಧನದಲ್ಲಿಯೇ ಉಳಿಯುತ್ತವೆ.",
